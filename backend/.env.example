# Copy to .env (never commit it) and fill in real values.
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/portfolio_contact?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=portfolio
DB_PASSWORD=change-me
JPA_DDL_AUTO=update

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-smtp-user@example.com
OWNER_EMAIL=owner@example.com

ALLOWED_ORIGINS=http://localhost:8080,https://dayarajportfolio.lovable.app
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
MAX_REQUEST_BYTES=16384
